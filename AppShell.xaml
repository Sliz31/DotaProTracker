<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DotaProTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DotaProTracker.Views"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Registration"
        ContentTemplate="{DataTemplate views:RegistrationPage}"
        Route="RegistrationPage" />

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="HomePage" />

    <ShellContent
        Title="Heroes"
        ContentTemplate="{DataTemplate views:HeroesPage}"
        Route="HeroesPage" />

    <ShellContent
        Title="Saved"
        ContentTemplate="{DataTemplate views:SavedPage}"
        Route="SavedPage" />

</Shell>