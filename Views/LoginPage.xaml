<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DotaProTracker.ViewModels"
             x:Class="DotaProTracker.Views.LoginPage"
             Title="LoginPage">

    <VerticalStackLayout Padding="20">
        <!-- Заголовок страницы -->
        <Label Text="Login"
               FontSize="26"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,20,0,10" />

        <!-- Picker для выбора метода входа -->
        <Picker Title="Select Login Method"
                ItemsSource="{Binding LoginMethods}"
                SelectedIndex="{Binding SelectedLoginMethodIndex}"
                HorizontalOptions="Center"
                Margin="0,10" />

        <!-- Поле ввода для логина (email или nickname) -->
        <Entry x:Name="LoginEntry" 
               Placeholder="{Binding LoginPlaceholder}"
               Text="{Binding LoginInput}"
               Margin="0,10" />

        <!-- Поле ввода пароля, привязка к ViewModel -->
        <Entry Placeholder="Enter your password"
               IsPassword="True"
               Text="{Binding Password}"
               Margin="0,10" />

        <!-- Кнопка входа -->
        <Button Text="Login" 
                BackgroundColor="Blue"
                TextColor="White"
                HorizontalOptions="Center"
                Margin="0,20"
                Clicked="OnLoginClicked" />
        
        <!-- Кнопка возрата на регистрацию -->
        <Label HorizontalOptions="Center" VerticalOptions="Center">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Don't have an account? " TextColor="Black" />
                    <Span Text="Regiser now!" TextColor="Blue" TextDecorations="Underline">
                        <Span.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegisterClicked" />
                        </Span.GestureRecognizers>
                    </Span>
                </FormattedString>
            </Label.FormattedText>
        </Label>
    </VerticalStackLayout>
</ContentPage>
